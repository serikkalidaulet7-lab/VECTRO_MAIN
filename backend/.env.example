APP_NAME=Vectro
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://vectro:vectro@localhost:5433/vectro
TEST_DATABASE_URL=postgresql+asyncpg://vectro:vectro@localhost:5433/vectro
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
JWT_ISSUER=vectro
JWT_AUDIENCE=vectro-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000
# Hosted platforms may store the complete PEM contents as secret environment values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Docker development prefers read-only mounted files instead of direct values.
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
